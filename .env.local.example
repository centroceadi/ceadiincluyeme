# Copiar a .env.local (nunca commitear .env.local — ya está en .gitignore).
# Proyecto Supabase propio de CeadiPortal. NO reutilizar el proyecto de Mi Bienestar.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: bypassea RLS. Solo se usa en src/lib/supabase/admin.ts,
# nunca en código de cliente. No exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada para redirects de auth, ej. reset de password).
# En Vercel: usar la preview/prod URL correspondiente por entorno.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
